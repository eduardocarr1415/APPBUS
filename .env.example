# El lanzador usa localhost para evitar exponer información en internet.
BUS_HOST=127.0.0.1
BUS_PORT=8000
# Solo active esta opción si existe HTTPS real delante del servidor.
BUS_HTTPS=0
# Solo active (1) si un proxy inverso de confianza (nginx, Caddy) añade la IP real al final de
# X-Forwarded-For. Si está en 0 se ignora esa cabecera para que nadie falsifique su IP.
BUS_TRUST_PROXY=0
